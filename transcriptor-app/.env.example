# Plantilla de variables de entorno.
# En local: copia este archivo como .env.local y pon los valores reales.
# En Vercel: estas mismas variables se configuran en el panel del proyecto.

# Obligatoria. La clave de Deepgram. Vive solo en el servidor: nunca llega al celular.
DEEPGRAM_API_KEY=

# Opcional pero recomendada. Si tiene valor, la app pide ese codigo antes de
# transcribir. Sirve para que nadie que encuentre la URL gaste el credito.
CODIGO_ACCESO=

# Opcionales. Solo si hay que cambiar de modelo o de idioma.
# DEEPGRAM_MODELO=nova-3
# DEEPGRAM_IDIOMA=es

# Opcional. Token de Vercel Blob para subir audios grandes (> 4.5 MB) en Vercel.
# Se genera automaticamente al crear un Blob Store en el panel de Vercel:
#   Proyecto → Storage → Create Database → Blob
# En local no hace falta: los archivos se envian directo sin pasar por Blob.
# BLOB_READ_WRITE_TOKEN=

